#!/bin/bash -e

source $cbtFunctionsDir/deploySourcePackage
source $cbtBaseDir/settings/extra-settings

name=linuxdoc-tools
version=0.9.56
group=Tools/Development
license=BSD/X11
description="Linux documentation tools"
src="l/linuxdoc-tools/${name}_${version}.tar.gz"
patches=("l/linuxdoc-tools/$name.lib64.diff")

showLongDescription()
{
    cat << "EOF"
LinuxDoc is a kind of SGML DTD. It was created for the Linux HOWTOs, and is
being used by the Linux Documentation Project (LDP).

Linuxdoc-Tools is in fact a small bug-fix version of SGML-Tools 1.0.9,
and is a toolset for processing LinuxDoc DTD SGML files.
EOF
}

buildPhase()
{
    ./configure --prefix=/usr
    make $globalBuildOptions
}

installPhase()
{
    make install
}
