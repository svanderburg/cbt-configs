 <!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
  "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">

<Menu>
    <Name>Applications</Name>

    <DefaultAppDirs/>
    <DefaultDirectoryDirs/>

    <!-- Graphics menu -->
    <Menu>
        <Name>Graphics</Name>
        <Include>
            <And>
                <Category>Graphics</Category>
                <Not>
                    <Category>KDE</Category>
                    <Category>GNOME</Category>
                </Not>
            </And>
        </Include>
    </Menu>

    <!-- Multimedia menu -->
    <Menu>
        <Name>Multimedia</Name>
        <Include>
            <And>
                <Or>
                    <Category>Audio</Category>
                    <Category>Video</Category>
                    <Category>AudioVideo</Category>
                </Or>
                <Not>
                    <Category>KDE</Category>
                    <Category>GNOME</Category>
                </Not>
            </And>
        </Include>
    </Menu>

    <!-- Development menu -->
    <Menu>
        <Name>Development</Name>
        <Include>
            <And>
                <Category>Development</Category>
                <Not>
                    <Category>KDE</Category>
                    <Category>GNOME</Category>
                </Not>
            </And>
        </Include>
    </Menu>

    <!-- Office menu -->
    <Menu>
        <Name>Office</Name>
        <Include>
            <And>
                <Category>Office</Category>
                <Not>
                    <Category>KDE</Category>
                    <Category>GNOME</Category>
                </Not>
            </And>
        </Include>
    </Menu>

    <!-- Network menu -->
    <Menu>
        <Name>Network</Name>
        <Include>
            <And>
                <Category>Network</Category>
                <Not>
                    <Category>KDE</Category>
                    <Category>GNOME</Category>
                </Not>
            </And>
        </Include>
    </Menu>

    <!-- Utilities menu -->
    <Menu>
        <Name>Utilities</Name>
        <Include>
            <And>
                <Category>Utility</Category>
                <Not>
                    <Category>KDE</Category>
                    <Category>GNOME</Category>
                </Not>
            </And>
        </Include>
    </Menu>

    <!-- System menu -->
    <Menu>
        <Name>System</Name>
        <Include>
            <And>
                <Category>System</Category>
                <Not>
                    <Category>KDE</Category>
                    <Category>GNOME</Category>
                </Not>
            </And>
        </Include>
    </Menu>

    <!-- Emulators menu -->
    <Menu>
        <Name>Emulators</Name>
        <Include>
            <And>
                <Category>Emulator</Category>
                <Not>
                    <Category>KDE</Category>
                    <Category>GNOME</Category>
                </Not>
            </And>
        </Include>
    </Menu>

    <!-- Games menu -->
    <Menu>
        <Name>Games</Name>
        <Include>
            <And>
                <Category>Game</Category>
                <Not>
                    <Category>KDE</Category>
                    <Category>GNOME</Category>
                    <Category>Shooter</Category>
                </Not>
            </And>

        </Include>

        <!-- Shooters sub menu -->
        <Menu>
            <Name>Shooters</Name>
            <Include>
                <And>
                    <Category>Game</Category>
                    <Category>Shooter</Category>
                    <Not>
                        <Category>KDE</Category>
                        <Category>GNOME</Category>
                    </Not>
                </And>
            </Include>
        </Menu>
    </Menu>

    <!-- Education menu -->
    <Menu>
        <Name>Education</Name>
        <Include>
            <And>
                <Category>Education</Category>
                <Not>
                    <Category>KDE</Category>
                    <Category>GNOME</Category>
                </Not>
            </And>
        </Include>
    </Menu>

    <!-- Science menu -->
    <Menu>
        <Name>Science</Name>
        <Include>
            <And>
                <Category>Science</Category>
                <Not>
                    <Category>KDE</Category>
                    <Category>GNOME</Category>
                </Not>
            </And>
        </Include>
    </Menu>

    <!-- Other menu -->
    <Menu>
        <Name>Other</Name>
        <OnlyUnallocated/>
        <Include>
            <And>
                <Not>
                    <Category>Settings</Category>
                    <Category>KDE</Category>
                    <Category>GNOME</Category>
                </Not>
            </And>
        </Include>
    </Menu>

    <!-- KDE menu -->
    <Menu>
        <Name>KDE Menu</Name>
        <MergeFile>ul-kde.menu</MergeFile>
    </Menu>

    <!-- GNOME menu -->
    <Menu>
        <Name>GNOME Menu</Name>
        <MergeFile>ul-gnome.menu</MergeFile>
    </Menu>
</Menu>
