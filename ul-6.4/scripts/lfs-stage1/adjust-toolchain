#!/bin/bash -e

source $cbtBaseDir/settings/lfs-stage1-settings

name=adjust-toolchain
group=lfs-stage1
description="Adjusts the toolchain used by gcc"

execute()
{
    # The linker, adjusted at the end of the first pass of Binutils, needs to be renamed so that it can be properly found and used
    mv -v /tools/bin/{ld,ld-old}
    mv -v /tools/$(gcc -dumpmachine)/bin/{ld,ld-old}
    mv -v /tools/bin/{ld-new,ld}
    ln -sv /tools/bin/ld /tools/$(gcc -dumpmachine)/bin/ld

    # Update the spec file to use the dynamic linker from our toolchain rather than the host system
    gcc -dumpspecs | sed 's@/lib/ld-linux.so.2@/tools&@g' \
      > `dirname $(gcc -print-libgcc-file-name)`/specs

    # Clean fixed header files that may accidentally end up in our build toolchain
    GCC_FIXED=`dirname $(gcc -print-libgcc-file-name)`/include-fixed &&
    find ${GCC_FIXED}/* -maxdepth 0 -xtype d -exec rm -rvf '{}' \; &&
    rm -vf `grep -l "DO NOT EDIT THIS FILE" ${GCC_FIXED}/*` &&
    unset GCC_FIXED
}
