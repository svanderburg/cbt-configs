#!/bin/bash -e

source $cbtFunctionsDir/deploySourcePackage
source $cbtBaseDir/settings/ul-packages-settings

name=xorg-cf-files
version=1.0.2
group=Display/X11/util
license=MIT
description="xorg-cf-files"
src="x/xorg/util/$name-$version.tar.bz2"

showLongDescription()
{
    cat << "EOF"
X.org generated util package: xorg-cf-files
EOF
}

buildPhase()
{
    ./configure $XORG_CONFIG --with-xorg-module-dir=/usr/X11R7.3/lib/X11/modules
    make
}

installPhase()
{
    make install
}
