#!/bin/bash -e

source $cbtFunctionsDir/deploySourcePackage
source $cbtBaseDir/settings/ul-packages-settings

name=recordproto
version=1.13.2
group=Display/X11/proto
license=MIT
description="recordproto"
src="x/xorg/proto/$name-$version.tar.bz2"

showLongDescription()
{
    cat << "EOF"
X.org generated proto package: recordproto
EOF
}

buildPhase()
{
    ./configure $XORG_CONFIG --with-xorg-module-dir=/usr/X11R7.3/lib/X11/modules
    make
}

installPhase()
{
    make install
}
