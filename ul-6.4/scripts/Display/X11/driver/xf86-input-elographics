#!/bin/bash -e

source $cbtFunctionsDir/deploySourcePackage
source $cbtBaseDir/settings/ul-packages-settings

name=xf86-input-elographics
version=1.0.0.5
group=Display/X11/driver
license=MIT
description="xf86-input-elographics"
src="x/xorg/driver/$name-$version.tar.bz2"

showLongDescription()
{
    cat << "EOF"
X.org generated driver package: xf86-input-elographics
EOF
}

buildPhase()
{
    ./configure $XORG_CONFIG --with-xorg-module-dir=/usr/X11R7.3/lib/X11/modules
    make
}

installPhase()
{
    make install
}
