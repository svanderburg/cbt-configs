#!/bin/bash -e

source $cbtFunctionsDir/deploySourcePackage
source $cbtBaseDir/settings/ul-packages-settings

name=libXrender
version=0.9.4
group=Display/X11/lib
license=MIT
description="libXrender"
src="x/xorg/lib/$name-$version.tar.bz2"

showLongDescription()
{
    cat << "EOF"
X.org generated lib package: libXrender
EOF
}

buildPhase()
{
    ./configure $XORG_CONFIG --with-xorg-module-dir=/usr/X11R7.3/lib/X11/modules
    make
}

installPhase()
{
    make install
}
