#!/bin/bash -e

source $cbtFunctionsDir/deploySourcePackage
source $cbtBaseDir/settings/ul-packages-settings

name=gv
version=3.5.8
group=Desktops/X11
license=GPLv2
description="Ghostscript frontend"
src="g/gv/$name-$version.tar.gz"

showLongDescription()
{
    cat << "EOF"
gv, an X11 ghostscript frontend based on Tim Theisen's ghostview 1.5.
EOF
}

# '

buildPhase()
{
    # Configure output directories
    mv config.Unix config.Unix.bak
    sed -e 's|/usr/local/bin/|/usr/bin|' \
        -e 's|/usr/local/doc/gv/|/usr/share/doc/gv/|' \
        -e 's|/usr/local/lib/gv/|/usr/lib/gv/|' \
        -e 's|/usr/local/man/man1/|/usr/share/man/man1/|' \
        config.Unix.bak > config.Unix

    xmkmf
    make Makefiles
    ln -s ../doc/gv.man source
    make
}

installPhase()
{
    make install
}
